rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Top-Level Collection 1: Users/{membershipNumber}
    match /Users/{membershipNumber} {
      allow read, write: if true;
    }

    // Top-Level Collection 2: Events/{eventId}
    match /Events/{eventId} {
      allow read, write: if true;
    }

    // Event registrations
    match /event_registrations/{regId} {
      allow read, write: if true;
    }

    // Backward compatibility aliases
    match /members/{memberId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    // Allow read/write for all application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
