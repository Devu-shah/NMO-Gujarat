rules_version = '2';

/**
 * National Medicos Organisation (NMO) Gujarat
 * Cloud Firestore Security Rules - Hardened Zero-Trust ABAC / RBAC
 *
 * Implements:
 * - Server-verified custom claims and `/admins/{uid}` verification (no reliance on frontend state/localStorage)
 * - Strict member profile isolation (members read/update own record, cannot self-assign roles or statuses)
 * - Anti-update-gap protection: restricted affectedKeys() on profile updates
 * - Event attendance and registration approvals strictly admin-controlled
 * - Certificate access restricted to verified owner or authorized administrators
 * - Inquiry & ticket privacy: no public listing or reference ID guessing leaks
 * - Sensitive configuration (SMTP, OAuth secrets, email credentials) completely locked to server-side Admin SDK
 * - Default-deny catch-all safety net
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE PRIMITIVES & IDENTITY HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // =========================================================================
    // SERVER-VERIFIED ADMINISTRATIVE ROLES
    // Derived from cryptographic Custom Claims or verified `/admins/{uid}` record
    // =========================================================================

    /**
     * Super Administrator (Full Secretariat access)
     * Verified via:
     * 1. Cryptographic Custom Claim: request.auth.token.role == 'super_admin'
     * 2. Server-verified document in /admins/{uid}
     * 3. Established Super Admin email fallback with verified identity
     */
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
        ) ||
        (
          request.auth.token.email in ['devanshshah768@gmail.com', 'superadmin@nmogujarat.org'] &&
          isVerifiedEmail()
        )
      );
    }

    /**
     * State Administrator (Gujarat & Saurashtra state-wide)
     */
    function isStateAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.role == 'state_admin' ||
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'state_admin'
          )
        )
      );
    }

    /**
     * Prant Administrator (Scoped to 'Gujarat' or 'Saurashtra')
     */
    function isPrantAdmin(prant) {
      return isStateAdmin() || (
        isAuthenticated() && (
          (
            request.auth.token.role == 'prant_admin' &&
            (request.auth.token.prant == prant || request.auth.token.prant == 'All' || prant == 'All')
          ) ||
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'prant_admin' &&
            (
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.prant == prant ||
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.prant == 'All' ||
              prant == 'All'
            )
          )
        )
      );
    }

    /**
     * City Administrator (Scoped to a specific city)
     */
    function isCityAdmin(city) {
      return isStateAdmin() || (
        isAuthenticated() && (
          (request.auth.token.role == 'city_admin' && request.auth.token.city == city) ||
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'city_admin' &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.city == city
          )
        )
      );
    }

    /**
     * General Admin Gate
     */
    function isAdmin() {
      return isStateAdmin() || (
        isAuthenticated() && (
          request.auth.token.role in ['super_admin', 'state_admin', 'prant_admin', 'city_admin'] ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    /**
     * Ownership verification (by Firebase Auth UID or verified Email)
     */
    function isOwner(uid, email) {
      return isAuthenticated() && (
        (uid != null && request.auth.uid == uid) ||
        (email != null && request.auth.token.email != null && request.auth.token.email.lower() == email.lower())
      );
    }

    /**
     * Check if user owns the membership number record
     */
    function isMemberOwner(membershipNo) {
      return isAuthenticated() && (
        (request.auth.token.membershipNumber != null && request.auth.token.membershipNumber == membershipNo) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );
    }

    // =========================================================================
    // 1. BOOT TEST & CONNECTION CHECK
    // =========================================================================
    match /test/{docId} {
      allow read: if true;
      allow write: if isStateAdmin();
    }

    // =========================================================================
    // 2. ADMIN REGISTRY (Server-Verified Admin Roles)
    // =========================================================================
    match /admins/{adminUid} {
      // Admins can read the registry; only Super Admin can grant or revoke admin roles
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. CITIES COLLECTION
    // =========================================================================
    match /Cities/{cityId} {
      allow read: if true;
      allow write: if isStateAdmin() || isAdmin();
    }

    // =========================================================================
    // 4. SETTINGS COLLECTION (Google Drive, Email, Secrets)
    // =========================================================================
    match /Settings/{settingId} {
      // Sensitive credential documents: BLOCKED from direct client-side reads/writes
      // (The backend Node.js server accesses them via Firebase Admin SDK)
      match /{allChildren=**} {
        allow read, write: if false;
      }

      // Non-sensitive settings: Public read for websiteSettings (lockdown check); Super Admin for others
      allow read: if settingId == 'websiteSettings' || (
                     isSuperAdmin() &&
                     settingId != 'smtpConfig' &&
                     settingId != 'emailConfig' &&
                     settingId != 'googleDriveAuth' &&
                     settingId != 'secrets'
                   );
      allow write: if isSuperAdmin() &&
                      settingId != 'smtpConfig' &&
                      settingId != 'emailConfig' &&
                      settingId != 'googleDriveAuth' &&
                      settingId != 'secrets';
    }

    // =========================================================================
    // 5. USERS COLLECTION (Document ID: membershipNumber)
    // =========================================================================
    match /Users/{membershipNumber} {
      // List query: Restricted to authorized Admins (prevents scraping entire membership directory)
      allow list: if isAdmin();

      // Single document get: Admins can inspect any member; Members can inspect only their own profile
      allow get: if isAdmin() || isMemberOwner(membershipNumber);

      // Create:
      // 1. State/Super Admins importing or enrolling members
      // 2. Authenticated user registering self as a standard 'member' (cannot self-assign admin roles)
      allow create: if isStateAdmin() || (
        isAuthenticated() &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'member' &&
        incoming().accountStatus in ['Active', 'Pending'] &&
        incoming().membershipNumber == membershipNumber
      );

      // Update:
      // 1. Super & State Admins have full administrative authority
      // 2. Prant Admin scoped strictly to members in their Prant (cannot change role or prant)
      // 3. Member Self-Update: Can ONLY update permitted personal profile fields
      //    (Phone, Email, Address, City, Pincode, Blood Group, College, Qualifications, Photo, Password)
      //    Members CANNOT change their role, account status, membership number, or prant!
      allow update: if isStateAdmin() || (
        // Prant Admin scoped update
        resource.data.prant != null &&
        isPrantAdmin(resource.data.prant) &&
        incoming().prant == resource.data.prant &&
        incoming().role == resource.data.role
      ) || (
        // Member Self-Update
        isOwner(resource.data.uid, resource.data.email) &&
        // Invariant: Privileged fields MUST remain strictly identical
        incoming().membershipNumber == resource.data.membershipNumber &&
        incoming().role == resource.data.role &&
        incoming().accountStatus == resource.data.accountStatus &&
        incoming().prant == resource.data.prant &&
        (resource.data.uid == null || incoming().uid == resource.data.uid) &&
        (resource.data.createdAt == null || incoming().createdAt == resource.data.createdAt) &&
        // Whitelist: Allowed keys only
        incoming().diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'email',
          'address',
          'city',
          'pincode',
          'bloodGroup',
          'medicalCollege',
          'qualifications',
          'specialization',
          'profilePhoto',
          'photoUrl',
          'displayName',
          'customPassword',
          'hasCustomPassword',
          'updatedAt'
        ])
      );

      // Delete: Super Administrators only
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6. EVENTS COLLECTION (Document ID: eventId)
    // =========================================================================
    match /Events/{eventId} {
      // Public read of official medical conferences, camps, and CMEs
      allow read: if true;

      // Create / Delete: Administrators only
      allow create: if isStateAdmin() || isAdmin() || (
        isAuthenticated() && (
          (incoming().prant != null && isPrantAdmin(incoming().prant)) ||
          (incoming().city != null && isCityAdmin(incoming().city))
        )
      );

      allow delete: if isStateAdmin() || (
        isAuthenticated() && resource.data.prant != null && isPrantAdmin(resource.data.prant)
      );

      // Update:
      // Event details, status, approvals, and attendance marking are strictly ADMIN-CONTROLLED
      allow update: if isStateAdmin() || isAdmin() || (
        isAuthenticated() && (
          (resource.data.prant != null && isPrantAdmin(resource.data.prant)) ||
          (resource.data.city != null && isCityAdmin(resource.data.city))
        )
      );
    }

    // =========================================================================
    // 7. EVENT REGISTRATIONS COLLECTION
    // =========================================================================
    match /event_registrations/{regId} {
      // List: Admins only
      allow list: if isAdmin();

      // Get: Admins or the registered member
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );

      // Create: Authenticated member registering for an event
      allow create: if isAdmin() || (
        isAuthenticated() &&
        (incoming().uid == request.auth.uid || incoming().email.lower() == request.auth.token.email.lower()) &&
        incoming().status in ['Pending', 'Submitted']
      );

      // Update:
      // 1. Admins approve/reject/mark attendance
      // 2. Member can only mark their own registration as 'Cancelled'
      allow update: if isStateAdmin() || isAdmin() || (
        isAuthenticated() &&
        isOwner(resource.data.uid, resource.data.email) &&
        incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'registrationStatus', 'updatedAt']) &&
        (incoming().status == 'Cancelled' || incoming().registrationStatus == 'Cancelled')
      );

      // Delete: Admins only
      allow delete: if isStateAdmin() || isAdmin();
    }

    // =========================================================================
    // 8. INQUIRIES & TICKETS COLLECTIONS (Support Desk & Grievances)
    // =========================================================================
    match /inquiries/{inquiryId} {
      // Public / Member can submit a new ticket with schema validation
      allow create: if incoming().keys().hasAll(['name', 'email', 'subject', 'message']) &&
                       incoming().name is string &&
                       incoming().email is string &&
                       incoming().message is string &&
                       incoming().status in ['open', 'pending'];

      // List: Admins only
      allow list: if isAdmin();

      // Get: Admins or authenticated submitter (prevents ID guessing leaks by unauthenticated strangers)
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );

      // Update:
      // 1. Admins providing solutions, notes, status transitions
      // 2. Submitter accepting resolution or providing feedback
      allow update: if isStateAdmin() || isAdmin() || (
        isAuthenticated() &&
        isOwner(resource.data.uid, resource.data.email) &&
        incoming().diff(resource.data).affectedKeys().hasOnly([
          'userApprovedResolution',
          'userFeedback',
          'userApprovedAt',
          'updatedAt'
        ])
      );

      allow delete: if isStateAdmin() || isAdmin();
    }

    match /Tickets/{ticketId} {
      allow create: if incoming().keys().hasAll(['name', 'email', 'subject', 'message']) &&
                       incoming().name is string &&
                       incoming().email is string &&
                       incoming().message is string &&
                       incoming().status in ['open', 'pending'];
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );
      allow update: if isStateAdmin() || isAdmin() || (
        isAuthenticated() &&
        isOwner(resource.data.uid, resource.data.email) &&
        incoming().diff(resource.data).affectedKeys().hasOnly([
          'userApprovedResolution',
          'userFeedback',
          'userApprovedAt',
          'updatedAt'
        ])
      );
      allow delete: if isStateAdmin() || isAdmin();
    }

    // =========================================================================
    // 9. CERTIFICATES COLLECTIONS
    // =========================================================================
    match /Certificates/{certId} {
      // List: Admins only
      allow list: if isAdmin();

      // Get: Admins or the certificate owner
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.memberUid == request.auth.uid ||
          resource.data.uploaderUid == request.auth.uid ||
          (request.auth.token.membershipNumber != null && resource.data.membershipNumber == request.auth.token.membershipNumber) ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );

      // Create: Admins or member uploading their own certificate (status set to pending)
      allow create: if isAdmin() || (
        isAuthenticated() && (
          incoming().memberUid == request.auth.uid ||
          incoming().uploaderUid == request.auth.uid ||
          (request.auth.token.membershipNumber != null && incoming().membershipNumber == request.auth.token.membershipNumber)
        ) &&
        incoming().approvalStatus in ['pending', 'pending_approval']
      );

      // Update:
      // 1. Admins approve/reject/change status
      // 2. Member can only update title of their own pending upload
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.approvalStatus == 'pending' &&
        (resource.data.memberUid == request.auth.uid || resource.data.uploaderUid == request.auth.uid) &&
        incoming().approvalStatus == 'pending' &&
        incoming().diff(resource.data).affectedKeys().hasOnly(['eventTitle', 'eventName', 'originalFileName', 'updatedAt'])
      );

      // Delete: Admins, or member deleting their own pending upload
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.approvalStatus == 'pending' &&
        (resource.data.memberUid == request.auth.uid || resource.data.uploaderUid == request.auth.uid)
      );
    }

    // Canonical compatibility collection for lowercase 'certificates'
    match /certificates/{certId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.memberUid == request.auth.uid ||
          resource.data.uploaderUid == request.auth.uid ||
          (request.auth.token.membershipNumber != null && resource.data.membershipNumber == request.auth.token.membershipNumber) ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );
      allow create: if isAdmin() || (
        isAuthenticated() && (
          incoming().memberUid == request.auth.uid ||
          incoming().uploaderUid == request.auth.uid ||
          (request.auth.token.membershipNumber != null && incoming().membershipNumber == request.auth.token.membershipNumber)
        ) &&
        incoming().approvalStatus in ['pending', 'pending_approval']
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.approvalStatus == 'pending' &&
        (resource.data.memberUid == request.auth.uid || resource.data.uploaderUid == request.auth.uid) &&
        incoming().approvalStatus == 'pending' &&
        incoming().diff(resource.data).affectedKeys().hasOnly(['eventTitle', 'eventName', 'originalFileName', 'updatedAt'])
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.approvalStatus == 'pending' &&
        (resource.data.memberUid == request.auth.uid || resource.data.uploaderUid == request.auth.uid)
      );
    }

    match /CertificateTombstones/{tombstoneId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 10. ANNOUNCEMENTS COLLECTION
    // =========================================================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStateAdmin() || isAdmin();
    }

    // =========================================================================
    // 11. AUDIT LOGS & IMPORT HISTORY
    // =========================================================================
    match /AuditLogs/{logId} {
      allow read, write: if isStateAdmin() || isAdmin();
    }

    match /ImportHistory/{historyId} {
      allow read, write: if isStateAdmin() || isAdmin();
    }

    match /ErrorLogs/{errorId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 12. MAIL COLLECTION (Trigger Email extension)
    // Client cannot read or modify emails. Writes restricted to admins.
    // =========================================================================
    match /mail/{mailId} {
      allow read, update, delete: if false;
      allow create: if isStateAdmin() || isAdmin();
    }

    // =========================================================================
    // 13. ZERO-TRUST DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
